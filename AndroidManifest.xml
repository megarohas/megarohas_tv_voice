<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.megarohas.tvvoice"
    android:versionCode="1"
    android:versionName="0.0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- Phase-0 acoustics test, started only from the Mac: DUMP is held by the
             adb shell but can't be granted to regular apps, so nothing else on the
             tablet can make it record. -->
        <activity
            android:name=".MicTestActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />
    </application>
</manifest>
