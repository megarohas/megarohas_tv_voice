<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.megarohas.tvhelper"
    android:versionCode="3"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- lets a background service open an app (launch / search) on Android 10+ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ hides other apps unless asked: the launchable ones and the searchable ones -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Notification access is only the key to MediaSessionManager: nothing reads notifications. -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Shared secret with the tablet, set from the Mac (DUMP is held by the adb shell only). -->
        <receiver
            android:name=".Setup"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
